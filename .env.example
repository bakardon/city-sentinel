# City Sentinel — example environment configuration
# Copy to .env and fill in what you need:  cp .env.example .env
# Every variable is optional. Active lines show the defaults the code uses;
# uncomment the '# NAME=' lines you need (leaving them empty would override defaults).

# ── Supabase (PostgreSQL + storage) ───────────────────────────────
# Without these, services fall back to in-memory storage.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=

# ── Inference hardware ───────────────────────────────────────────
# Set to 1 to force GPU inference for face/plate models
# FORCE_GPU=1
YOLO_INFERENCE_BACKEND=auto
YOLO_FP16=1
YOLO_MODEL_PATH=yolov8m.pt
YOLO_TASK=auto

# ── Face recognition / RTSP ───────────────────────────────────────
# rtsp://<user>:<password>@<camera-host>:554/<stream-path>
# RTSP_URL=
CAMERA_ID=cam_101
FACE_MATCH_THRESHOLD=0.45
RTSP_FACE_MATCH_THRESHOLD=0.40
RTSP_FACE_DETECT_INTERVAL_MS=250
RTSP_PROCESS_INTERVAL_MS=300
RTSP_RECONNECT_MS=2000

# ── ANPR (number plates) ─────────────────────────────────────────
# PLATE_MODEL_PATH=
PLATE_OCR_USE_GPU=auto
ENTRY_CAMERA_ID=entry
EXIT_CAMERA_ID=exit
# VEHICLE_LOGS_TABLE=
MISSING_VEHICLE_THRESHOLD_S=60

# ── Accident detection ───────────────────────────────────────────
# ACCIDENT_WEIGHTS_PATH=
# ACCIDENT_RTSP_URL=
# ACCIDENT_CAMERA_ID=
ACCIDENT_DEVICE=auto
ACCIDENT_WORKER_AUTOSTART=1

# ── Fire / smoke detection ───────────────────────────────────────
# FIRE_WEIGHTS_PATH=
# FIRE_RTSP_URL=
# FIRE_CAMERA_ID=
# FIRE_CAMERA_LOCATION=
FIRE_DEVICE=auto
FIRE_CONF_THRESHOLD=0.50
FIRE_EVENTS_TABLE=fire_events
FIRE_SNAPSHOTS_BUCKET=fire-snapshots
FIRE_WORKER_AUTOSTART=0

# ── Knife detection ──────────────────────────────────────────────
# KNIFE_WEIGHTS_PATH=
# KNIFE_RTSP_URL=
# KNIFE_CAMERA_ID=
# KNIFE_CAMERA_LOCATION=
KNIFE_DEVICE=auto
KNIFE_CONF_THRESHOLD=0.45
KNIFE_EVENTS_TABLE=knife_events
KNIFE_SNAPSHOTS_BUCKET=knife-snapshots
KNIFE_WORKER_AUTOSTART=0

# ── Weapon detection ─────────────────────────────────────────────
# WEAPON_WEIGHTS_PATH=
# WEAPON_RTSP_URL=
# WEAPON_CAMERA_ID=
# WEAPON_CAMERA_LOCATION=
WEAPON_DEVICE=auto
WEAPON_CONF_THRESHOLD=0.45
WEAPON_EVENTS_TABLE=weapon_events
WEAPON_SNAPSHOTS_BUCKET=weapon-snapshots
WEAPON_WORKER_AUTOSTART=0

# ── Violence detection ───────────────────────────────────────────
# VIOLENCE_WEIGHTS_PATH=
# VIOLENCE_RTSP_URL=
# VIOLENCE_CAMERA_ID=
# VIOLENCE_CAMERA_LOCATION=
VIOLENCE_DEVICE=auto
VIOLENCE_CONF_THRESHOLD=0.45
VIOLENCE_LIVE_CONF_THRESHOLD=0.80
VIOLENCE_EVENTS_TABLE=violence_events
VIOLENCE_SNAPSHOTS_BUCKET=violence-snapshots
VIOLENCE_WORKER_AUTOSTART=0

# Further tuning knobs (FPS, image size, cooldowns, tracker TTLs) are read
# with sensible defaults; see the *_service.py files in app/ for the full list.
